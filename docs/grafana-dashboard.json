    {
      "type": "stat",
      "title": "房間存活時間",
      "description": "閒置清掉的房間，從開房到清掉的時間。包含最後 24 小時的閒置等待。wiped 是清掉的房間數。",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_HANGBAH}"
          },
          "format": "table",
          "editorMode": "sql",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "extrapolate": false,
          "skip_comments": true,
          "add_metadata": false,
          "round": "0s",
          "intervalFactor": 1,
          "interval": "",
          "query": "SELECT quantileExactWeighted(0.5)(double1, _sample_interval) / 3600000 AS p50, quantileExactWeighted(0.9)(double1, _sample_interval) / 3600000 AS p90, SUM(_sample_interval) AS wiped FROM hangbah_events WHERE $timeFilter AND blob1 = 'room_wiped'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "wiped"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
