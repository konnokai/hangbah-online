    {
      "type": "barchart",
      "title": "各食材 放／吃／燒",
      "description": "custom 是所有自訂食材加總。",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_HANGBAH}"
          },
          "format": "table",
          "editorMode": "sql",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "extrapolate": false,
          "skip_comments": true,
          "add_metadata": false,
          "round": "0s",
          "intervalFactor": 1,
          "interval": "",
          "query": "SELECT blob2 AS food, sumIf(_sample_interval, blob1 = 'food_spawned') AS spawned, sumIf(_sample_interval, blob1 = 'food_eaten') AS eaten, sumIf(_sample_interval, blob1 = 'food_burned') AS burned FROM hangbah_events WHERE $timeFilter AND blob2 != '' GROUP BY food ORDER BY spawned DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "food",
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "id": 15,
