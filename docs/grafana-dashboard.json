          "skip_comments": true,
          "add_metadata": false,
          "round": "0s",
          "intervalFactor": 1,
          "interval": "",
          "query": "SELECT $timeSeries AS t, blob3 AS label, SUM(_sample_interval) AS n FROM hangbah_events WHERE $timeFilter AND blob1 = 'player_joined' GROUP BY label, t ORDER BY t"
